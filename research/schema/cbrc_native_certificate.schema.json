{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maveb.local/schema/cbrc-native-certificate-v1.json",
  "title": "MAVEB CBRC native planner certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "graphVersion",
    "boundVersion",
    "costModelVersion",
    "stable",
    "passes",
    "fullRebuild",
    "reason",
    "work",
    "fullWork",
    "workRatioFull",
    "cone",
    "exterior",
    "qois"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifact": {"const": "maveb-cbrc-native-certificate"},
    "graphVersion": {"type": "string", "minLength": 1},
    "boundVersion": {"type": "string", "minLength": 1},
    "costModelVersion": {"type": "string", "minLength": 1},
    "stable": {"type": "boolean"},
    "passes": {"type": "boolean"},
    "fullRebuild": {"type": "boolean"},
    "reason": {"type": "string"},
    "work": {"type": "number", "minimum": 0},
    "fullWork": {"type": "number", "minimum": 0},
    "workRatioFull": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "cone": {"$ref": "#/$defs/nodeArray"},
    "exterior": {"$ref": "#/$defs/nodeArray"},
    "qois": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bound", "epsilon", "passes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "bound": {"type": "number", "minimum": 0},
          "epsilon": {"type": "number", "minimum": 0},
          "passes": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "nodeArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "name": {"type": "string"}
        }
      }
    }
  }
}
