{
  "schemaVersion": 1,
  "id": "metric-uncertainty-v1",
  "protocolVersion": "1.1",
  "status": "preregistered-before-public-acquisition",
  "researchQuestion": "Can calibrated geometric uncertainty from heterogeneous consumer sensors improve sparse-view metric reconstruction without hiding geometry errors behind rendering quality?",
  "primaryHypothesis": "Held-out sparse-view geometry improves when metric observations are weighted by calibrated inverse variance rather than naive confidence products.",
  "scopeFreeze": [
    "editor-polish",
    "new-pbr-features",
    "relighting",
    "cinematic-tooling",
    "semantic-features",
    "unrelated-gltf-expansion"
  ],
  "publicEvidence": {
    "dataset": "CA-1M / Cubify Anything",
    "observation": "onboard ARKit LiDAR depth",
    "groundTruth": "FARO laser-scanner rendered depth",
    "splitFile": "benchmarks/experiments/metric-uncertainty-public-split-v1.json",
    "splitRevision": 2,
    "calibrationScenes": 3,
    "heldOutScenes": 5,
    "sceneUnitOfEvidence": true,
    "rayCorrespondence": "map ARKit-depth pixel ray into FARO GT depth using separately released intrinsics",
    "invalidGroundTruthRule": "zero FARO depth is unregistered and excluded"
  },
  "methods": [
    {"id": "B0-sfm-only", "description": "RGB/SfM baseline with no metric-depth prior"},
    {"id": "B1-naive-confidence", "description": "Metric depth weighted by sensorConfidence * poseConfidence"},
    {"id": "B2-uniform-depth", "description": "All accepted metric-depth observations receive equal weight"},
    {"id": "U1-public-sensor-uncertainty", "description": "CA-1M-calibrated sensor/depth uncertainty terms"},
    {"id": "U2-no-sensor-confidence", "description": "Calibrated model with sensor confidence replaced by a constant"},
    {"id": "U3-shuffled-confidence", "description": "Negative control with deterministic within-scene confidence permutation"},
    {"id": "U4-full-v1", "description": "Full decomposed metric uncertainty after paired alignment terms are identified"}
  ],
  "datasets": {
    "calibration": {
      "minimumScenes": 3,
      "families": ["CA-1M"],
      "groundTruth": "FARO laser depth"
    },
    "heldOutPublic": {
      "minimumScenes": 5,
      "families": ["CA-1M"],
      "groundTruth": "FARO laser depth"
    },
    "rgbGeometryControls": ["ETH3D", "DTU"],
    "smokeOnly": ["arkitscenes-47333462"],
    "pairedMaveb": {
      "minimumScenes": 8,
      "sensors": ["Sony RGB", "iPad RGB+LiDAR"],
      "sceneClasses": [
        "texture-rich-planar",
        "texture-poor",
        "thin-structures",
        "fine-geometry",
        "reflective-glossy",
        "mixed-depth",
        "repeated-texture",
        "occlusion-heavy"
      ]
    }
  },
  "stressMatrix": {
    "viewCounts": [4, 8, 12, 24],
    "depthDropoutFractions": [0.0, 0.25, 0.5, 0.75],
    "alignmentTranslationNoiseMillimetres": [0, 10, 25, 50],
    "alignmentRotationNoiseDegrees": [0, 1, 2, 5],
    "confidenceControls": ["intact", "constant", "shuffled"],
    "seeds": [11, 23, 42]
  },
  "uncertaintyModel": {
    "status": "hypothesis-prior-not-calibrated",
    "combination": "independent-zero-mean-variance-sum",
    "defaults": {
      "minimumSigmaMetres": 0.001,
      "maximumSigmaMetres": 0.25,
      "depthNoiseFloorMetres": 0.002,
      "depthNoiseQuadraticMetresPerMetreSquared": 0.0015,
      "sensorConfidencePenalty": 2.0,
      "poseTranslationFloorMetres": 0.001,
      "poseTranslationScaleMetres": 0.02,
      "referenceSigmaMetres": 0.01,
      "minimumPrecisionWeight": 0.01,
      "maximumPrecisionWeight": 1.0
    },
    "publicFitTerms": [
      "depthNoiseFloorMetres",
      "depthNoiseQuadraticMetresPerMetreSquared",
      "sensorConfidencePenalty"
    ],
    "frozenUntilPairedStudy": [
      "poseTranslationFloorMetres",
      "poseTranslationScaleMetres",
      "cross-sensor alignment terms"
    ],
    "fittingRule": "fit only on frozen calibration scenes; freeze model/input/split hashes before any held-out evaluation"
  },
  "metrics": {
    "geometry": [
      "accuracy-mean-m",
      "accuracy-median-m",
      "accuracy-p95-m",
      "completeness-mean-m",
      "completeness-median-m",
      "completeness-p95-m",
      "chamfer-m",
      "fscore",
      "normal-angular-error-deg"
    ],
    "uncertainty": [
      "rmse-m",
      "expected-calibration-error-m",
      "gaussian-nll",
      "coverage-1sigma",
      "coverage-2sigma",
      "pearson-sigma-absolute-error",
      "sharpness-rms-sigma-m"
    ],
    "rendering": ["psnr-db", "ssim", "lpips"],
    "systems": ["wall-time-s", "peak-resident-memory-bytes", "gaussian-count", "resident-tsdf-blocks"]
  },
  "statistics": {
    "evidenceUnit": "scene",
    "pairedComparisons": true,
    "bootstrapConfidence": 0.95,
    "bootstrapReplicates": 2000,
    "bootstrapSeed": 42,
    "reportAllScenes": true
  },
  "positiveClaimGate": {
    "condition": "8-view held-out sparse reconstruction",
    "minimumMedianRelativeChamferImprovementVsB1": 0.10,
    "pairedBootstrapIntervalMustExcludeZero": true,
    "shuffledConfidenceMustUnderperformFullModel": true,
    "maximumRelativeLpipsRegression": 0.03
  },
  "implementationGates": [
    {"id": "U0", "name": "measurement", "requirements": ["deterministic predictor", "calibration evaluator", "causal controls", "unit tests", "hashed reports"]},
    {"id": "U1", "name": "public-calibration", "requirements": ["three frozen CA-1M train captures", "FARO-vs-ARKit signed error samples", "sensor-only fitted/frozen coefficients"]},
    {"id": "U2", "name": "held-out-calibration", "requirements": ["five frozen CA-1M val captures", "no retuning", "intact/constant/shuffled reports", "failure analysis"]},
    {"id": "U3", "name": "fusion-ablation", "requirements": ["opt-in inverse-variance dense CPU TSDF weighting", "legacy baselines preserved", "full stress matrix"]},
    {"id": "U4", "name": "gaussian-ablation", "requirements": ["separate initialization, optimization, densification, pruning and regularization ablations"]}
  ]
}
