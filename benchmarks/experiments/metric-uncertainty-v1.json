{
  "schemaVersion": 1,
  "id": "metric-uncertainty-v1",
  "status": "preregistered-u0",
  "researchQuestion": "Can calibrated geometric uncertainty from heterogeneous consumer sensors improve sparse-view metric reconstruction without hiding geometry errors behind rendering quality?",
  "primaryHypothesis": "Held-out sparse-view geometry improves when metric observations are weighted by calibrated inverse variance rather than naive confidence products.",
  "scopeFreeze": [
    "editor-polish",
    "new-pbr-features",
    "relighting",
    "cinematic-tooling",
    "semantic-features",
    "unrelated-gltf-expansion"
  ],
  "methods": [
    {
      "id": "B0-sfm-only",
      "description": "RGB/SfM baseline with no metric-depth prior"
    },
    {
      "id": "B1-naive-confidence",
      "description": "Metric depth weighted by sensorConfidence * poseConfidence"
    },
    {
      "id": "B2-uniform-depth",
      "description": "All accepted metric-depth observations receive equal weight"
    },
    {
      "id": "U1-no-alignment",
      "description": "Uncertainty model without cross-sensor alignment terms"
    },
    {
      "id": "U2-no-sensor-confidence",
      "description": "Full model with sensor confidence replaced by a constant"
    },
    {
      "id": "U3-shuffled-confidence",
      "description": "Negative control with deterministic confidence permutation"
    },
    {
      "id": "U4-full-v1",
      "description": "Full decomposed metric uncertainty model"
    }
  ],
  "datasets": {
    "calibration": {
      "minimumScenes": 3,
      "families": [
        "ARKitScenes"
      ],
      "note": "arkitscenes-47333462 is an engineering smoke scene and may be included in calibration, never as sole evidence"
    },
    "heldOutPublic": {
      "minimumScenes": 5,
      "families": [
        "ARKitScenes",
        "ETH3D",
        "DTU"
      ]
    },
    "pairedMaveb": {
      "minimumScenes": 8,
      "sensors": [
        "Sony RGB",
        "iPad RGB+LiDAR"
      ],
      "sceneClasses": [
        "texture-rich-planar",
        "texture-poor",
        "thin-structures",
        "fine-geometry",
        "reflective-glossy",
        "mixed-depth",
        "repeated-texture",
        "occlusion-heavy"
      ]
    }
  },
  "stressMatrix": {
    "viewCounts": [
      4,
      8,
      12,
      24
    ],
    "depthDropoutFractions": [
      0.0,
      0.25,
      0.5,
      0.75
    ],
    "alignmentTranslationNoiseMillimetres": [
      0,
      10,
      25,
      50
    ],
    "alignmentRotationNoiseDegrees": [
      0,
      1,
      2,
      5
    ],
    "confidenceControls": [
      "intact",
      "constant",
      "shuffled"
    ],
    "seeds": [
      11,
      23,
      42
    ]
  },
  "uncertaintyModel": {
    "status": "hypothesis-prior-not-calibrated",
    "combination": "independent-zero-mean-variance-sum",
    "defaults": {
      "minimumSigmaMetres": 0.001,
      "maximumSigmaMetres": 0.25,
      "depthNoiseFloorMetres": 0.002,
      "depthNoiseQuadraticMetresPerMetreSquared": 0.0015,
      "sensorConfidencePenalty": 2.0,
      "poseTranslationFloorMetres": 0.001,
      "poseTranslationScaleMetres": 0.02,
      "referenceSigmaMetres": 0.01,
      "minimumPrecisionWeight": 0.01,
      "maximumPrecisionWeight": 1.0
    },
    "fittingRule": "fit only on calibration scenes; freeze before any held-out evaluation"
  },
  "metrics": {
    "geometry": [
      "accuracy-mean-m",
      "accuracy-median-m",
      "accuracy-p95-m",
      "completeness-mean-m",
      "completeness-median-m",
      "completeness-p95-m",
      "chamfer-m",
      "fscore",
      "normal-angular-error-deg"
    ],
    "uncertainty": [
      "expected-calibration-error-m",
      "gaussian-nll",
      "coverage-1sigma",
      "coverage-2sigma",
      "pearson-sigma-absolute-error",
      "sharpness-rms-sigma-m"
    ],
    "rendering": [
      "psnr-db",
      "ssim",
      "lpips"
    ],
    "systems": [
      "wall-time-s",
      "peak-resident-memory-bytes",
      "gaussian-count",
      "resident-tsdf-blocks"
    ]
  },
  "statistics": {
    "evidenceUnit": "scene",
    "pairedComparisons": true,
    "bootstrapConfidence": 0.95,
    "bootstrapReplicates": 2000,
    "bootstrapSeed": 42,
    "reportAllScenes": true
  },
  "positiveClaimGate": {
    "condition": "8-view held-out sparse reconstruction",
    "minimumMedianRelativeChamferImprovementVsB1": 0.10,
    "pairedBootstrapIntervalMustExcludeZero": true,
    "shuffledConfidenceMustUnderperformFullModel": true,
    "maximumRelativeLpipsRegression": 0.03
  },
  "implementationGates": [
    {
      "id": "U0",
      "name": "measurement",
      "requirements": [
        "deterministic decomposed uncertainty predictor",
        "deterministic calibration evaluator",
        "unit tests",
        "hashed JSON reports"
      ]
    },
    {
      "id": "U1",
      "name": "public-calibration",
      "requirements": [
        "at least three calibration scenes",
        "fitted and frozen coefficients"
      ]
    },
    {
      "id": "U2",
      "name": "held-out-calibration",
      "requirements": [
        "at least five disjoint scenes",
        "reported calibration curves and negative control"
      ]
    },
    {
      "id": "U3",
      "name": "fusion-ablation",
      "requirements": [
        "opt-in inverse-variance CPU TSDF weighting",
        "bit-for-bit legacy baselines preserved"
      ]
    },
    {
      "id": "U4",
      "name": "gaussian-ablation",
      "requirements": [
        "separate initialization, optimization, densification, and regularization ablations"
      ]
    }
  ]
}
