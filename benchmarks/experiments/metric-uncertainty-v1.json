{
  "schemaVersion": 1,
  "id": "metric-uncertainty-v1",
  "protocolVersion": "1.3",
  "status": "u1b-robust-calibration-frozen-before-heldout",
  "researchQuestion": "Can calibrated geometric uncertainty from heterogeneous consumer sensors improve sparse-view metric reconstruction without hiding geometry errors behind rendering quality?",
  "primaryHypothesis": "Held-out sparse-view geometry improves when metric observations are weighted by calibrated inverse variance rather than naive confidence products.",
  "scopeFreeze": [
    "editor-polish",
    "new-pbr-features",
    "relighting",
    "cinematic-tooling",
    "semantic-features",
    "unrelated-gltf-expansion"
  ],
  "publicEvidence": {
    "dataset": "CA-1M / Cubify Anything",
    "observation": "onboard ARKit LiDAR depth",
    "groundTruth": "FARO laser-scanner rendered depth",
    "confidenceDataset": "ARKitScenes raw confidence",
    "orientationWitness": "ARKitScenes raw lowres_depth; discrete transform selection only",
    "splitFile": "benchmarks/experiments/metric-uncertainty-public-split-v1.json",
    "splitRevision": 4,
    "calibrationScenes": 3,
    "heldOutScenes": 5,
    "sceneUnitOfEvidence": true,
    "rayCorrespondence": "map ARKit-depth pixel ray into FARO GT depth using separately released intrinsics",
    "invalidGroundTruthRule": "zero FARO depth is unregistered and excluded",
    "sidecarTimestampToleranceMilliseconds": 20.0
  },
  "methods": [
    {"id": "B0-sfm-only", "description": "RGB/SfM baseline with no metric-depth prior"},
    {"id": "B1-naive-confidence", "description": "Metric depth weighted by sensorConfidence * poseConfidence"},
    {"id": "B2-uniform-depth", "description": "All accepted metric-depth observations receive equal weight"},
    {"id": "U1a-gaussian-sensor-uncertainty", "description": "Original scene-balanced Gaussian calibration; retained as failed heavy-tail model"},
    {"id": "U1b-student-t3-sensor-uncertainty", "description": "Fixed Student-t(3) robust calibration on the exact U1a sample set"},
    {"id": "U2-no-sensor-confidence", "description": "Frozen robust model with sensor confidence replaced by a constant"},
    {"id": "U3-shuffled-confidence", "description": "Negative control with deterministic within-scene confidence permutation"},
    {"id": "U4-full-v1", "description": "Full decomposed metric uncertainty after paired alignment terms are identified"}
  ],
  "datasets": {
    "calibration": {
      "minimumScenes": 3,
      "families": ["CA-1M"],
      "groundTruth": "FARO laser depth",
      "rawSamples": 455693,
      "deterministicFitSamples": 294706
    },
    "heldOutPublic": {
      "minimumScenes": 5,
      "families": ["CA-1M"],
      "groundTruth": "FARO laser depth",
      "sidecarsLockedUntilU1bFreeze": true
    },
    "rgbGeometryControls": ["ETH3D", "DTU"],
    "smokeOnly": ["arkitscenes-47333462"],
    "pairedMaveb": {
      "minimumScenes": 8,
      "sensors": ["Sony RGB", "iPad RGB+LiDAR"],
      "sceneClasses": [
        "texture-rich-planar",
        "texture-poor",
        "thin-structures",
        "fine-geometry",
        "reflective-glossy",
        "mixed-depth",
        "repeated-texture",
        "occlusion-heavy"
      ]
    }
  },
  "stressMatrix": {
    "viewCounts": [4, 8, 12, 24],
    "depthDropoutFractions": [0.0, 0.25, 0.5, 0.75],
    "alignmentTranslationNoiseMillimetres": [0, 10, 25, 50],
    "alignmentRotationNoiseDegrees": [0, 1, 2, 5],
    "confidenceControls": ["intact", "constant", "shuffled"],
    "seeds": [11, 23, 42]
  },
  "uncertaintyModel": {
    "combination": "independent-zero-mean-variance-sum",
    "defaults": {
      "minimumSigmaMetres": 0.001,
      "maximumSigmaMetres": 0.25,
      "depthNoiseFloorMetres": 0.002,
      "depthNoiseQuadraticMetresPerMetreSquared": 0.0015,
      "sensorConfidencePenalty": 2.0,
      "poseTranslationFloorMetres": 0.001,
      "poseTranslationScaleMetres": 0.02,
      "referenceSigmaMetres": 0.01,
      "minimumPrecisionWeight": 0.01,
      "maximumPrecisionWeight": 1.0
    },
    "publicFitTerms": [
      "depthNoiseFloorMetres",
      "depthNoiseQuadraticMetresPerMetreSquared",
      "sensorConfidencePenalty"
    ],
    "parameterBounds": {
      "depthNoiseFloorMetres": [0.00001, 0.10],
      "depthNoiseQuadraticMetresPerMetreSquared": [0.0, 0.05],
      "sensorConfidencePenalty": [0.0, 20.0]
    },
    "u1a": {
      "likelihood": "Gaussian",
      "status": "failed-heavy-tail-calibration",
      "modelSha256": "e34bf28d242f5eb7097751263afc79bde25335d08e805cf27b12ef20901a3509",
      "calibrationInputSha256": "9b225e2398aa9f116c27b9f9cd3f3916dca83d82e8a3bae5818673b059698067",
      "failureReason": "both geometric noise terms hit exact upper bounds and 31.7% of calibration predictions hit 0.25 m sigma cap"
    },
    "u1b": {
      "likelihood": "Student-t",
      "degreesOfFreedom": 3.0,
      "degreesOfFreedomFitted": false,
      "sigmaInterpretation": "standard deviation",
      "studentTScale": "sigma * sqrt((nu - 2) / nu)",
      "sameSamplesAsU1a": true,
      "sameBoundsAsU1a": true,
      "sampleFiltering": "none",
      "status": "preregistered-before-heldout"
    },
    "frozenUntilPairedStudy": [
      "poseTranslationFloorMetres",
      "poseTranslationScaleMetres",
      "cross-sensor alignment terms"
    ],
    "fittingRule": "fit only on frozen calibration scenes; freeze robust model/input/split/code hashes before any held-out sidecar acquisition or evaluation"
  },
  "metrics": {
