# fastgltf uses scoped enums as bitmask flags, which the disabled optional checker misclassifies.
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override
WarningsAsErrors: ''
HeaderFilterRegex: '^(engine|apps|tools|tests)/'
